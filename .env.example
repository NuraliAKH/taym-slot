# Telegram Bot Token from @BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Uzum API Endpoint (Default is official seller API)
UZUM_BASE_API_URL=https://api-seller.uzum.uz

# Poll interval in seconds (recommended 1.5 - 3.0 seconds)
DEFAULT_POLL_INTERVAL=2.0

# Database file location
DB_PATH=uzum_bot.db
